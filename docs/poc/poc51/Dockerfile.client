# POC-51 client: the Python driver the e2e suite uses for its Broker check
# (test/e2e/ha_bootstrap_test.go), with the script of this directory.
FROM docker.io/library/python:3.12-slim
RUN pip install --no-cache-dir pycubrid==1.9.0
COPY client.py /client.py
USER 65532:65532
ENTRYPOINT ["python3", "-u", "/client.py"]
